# Required local application settings. Change these before exposing the app.
JWT_SECRET=replace-this-with-a-long-random-secret
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-this-password

# Local MongoDB is provided by the Podman Compose stack.
MONGODB_URI=mongodb://mongo:27017/prescripto

# Frontend build settings
VITE_BACKEND_URL=http://localhost:4000
VITE_CURRENCY=INR

# Keep services local by default. For a cloud VM, set this to 0.0.0.0.
HOST_BIND_IP=127.0.0.1
