FROM node:20-alpine

WORKDIR /app

COPY admin/package*.json ./
RUN npm ci

COPY admin/ ./

ARG VITE_BACKEND_URL=http://localhost:4000
ARG VITE_CURRENCY=INR
ENV VITE_BACKEND_URL=${VITE_BACKEND_URL}
ENV VITE_CURRENCY=${VITE_CURRENCY}

RUN npm run build

EXPOSE 5174

CMD ["npm", "run", "preview", "--", "--host", "0.0.0.0", "--port", "5174"]
